PORT=3000
AI_SERVICE_URL=http://localhost:8000/predict

# PostgreSQL Database Configuration (Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=found_reports

# Atau menggunakan Supabase / Cloud PostgreSQL (URI / Connection String)
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Secret untuk Autentikasi Admin
JWT_SECRET=your_jwt_secret_key
